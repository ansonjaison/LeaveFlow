# ============================================================
# LeaveFlow — .gitignore
# ============================================================

# ============================================================
# Maven
# ============================================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Note: .mvn/wrapper/maven-wrapper.properties SHOULD be committed.
# We explicitly allow the wrapper jar if it exists, though modern wrappers download it dynamically.
!.mvn/wrapper/maven-wrapper.jar

# ============================================================
# Java / Spring Boot
# ============================================================
*.class
*.log
logs/
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
# Don't ignore the maven wrapper jar if present
!.mvn/wrapper/maven-wrapper.jar

# ============================================================
# IDE files
# ============================================================
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.vscode/
.factorypath
.springBeans

# ============================================================
# OS files
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Environment / Secrets
# ============================================================
# .env holds real credentials — NEVER commit it
.env
.env.local
.env.production
.env.*

# Local Spring Boot property overrides
application-local.properties
application-secret.properties
